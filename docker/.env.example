# ============================================================
# Media Center — Variables de entorno
# Copiá este archivo como .env y editá los valores
# ============================================================

# Zona horaria
TZ=America/Argentina/Buenos_Aires

# Usuario y grupo del sistema (en Windows usar 1000)
PUID=1000
PGID=1000

# Rutas absolutas de configuración y datos
# En Windows usar barras normales: F:/docker/config
CONFIG_PATH=/ruta/a/tu/config
DATA_PATH=/ruta/a/tu/data
