# ============================================================
# 🎬 Media Center — Configuración de Ejemplo
# ============================================================
# Copiá este archivo como '.env' y ajustá los valores a tu servidor:
# cp .env.example .env

# Ruta raíz para descargas y media (ej: D:/data o /mnt/storage/data)
DATA_PATH=D:/data

# Ruta para configuraciones de servicios (ej: C:/docker/config o /opt/docker/config)
CONFIG_PATH=C:/docker/config

# Zona horaria
TZ=America/Argentina/Buenos_Aires

# Usuario / Grupo ID
PUID=1000
PGID=1000
